FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY next.config.ts ./
COPY tailwind.config.ts ./
COPY tsconfig.json ./
COPY postcss.config.mjs ./

# Install dependencies
RUN npm ci

# Copy source code
COPY src/ ./src/
COPY public/ ./public/
COPY components.json ./

# Create contracts directory
RUN mkdir -p src/contracts

# Expose frontend port
EXPOSE 3000

# Start the development server
CMD ["npm", "run", "dev"]